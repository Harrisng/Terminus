<Window x:Class="Terminus.UI.Windows.WarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminus"
        Width="460" Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Background="{DynamicResource BgPrimary}">

    <Border Padding="28">
        <StackPanel>
            <!-- Icon + Title -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock x:Name="IconText" Text="⚠️" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="TitleText"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Message -->
            <TextBlock x:Name="MessageText"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <!-- Quota Info -->
            <Border x:Name="QuotaBorder"
                    Background="{DynamicResource BgSecondary}"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,20">
                <TextBlock x:Name="QuotaText"
                           FontSize="13"
                           Foreground="{DynamicResource TextTertiary}"/>
            </Border>

            <!-- Action Buttons -->
            <StackPanel x:Name="ButtonPanel">
                <!-- 延後 30 分鐘 -->
                <Button x:Name="DelayButton"
                        Click="DelayButton_Click"
                        Margin="0,0,0,8"
                        Height="44"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{DynamicResource AccentPrimary}" CornerRadius="8" BorderThickness="0">
                                <TextBlock Text="⏰ 延後 30 分鐘" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 立即關機 -->
                <Button x:Name="ShutdownButton"
                        Click="ShutdownButton_Click"
                        Margin="0,0,0,8"
                        Height="44"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{DynamicResource StatusError}" CornerRadius="8" BorderThickness="0">
                                <TextBlock Text="⚡ 立即關機" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 確認（確認模式用） -->
            <Button x:Name="ConfirmButton"
                    Click="ConfirmButton_Click"
                    Visibility="Collapsed"
                    Margin="0,0,0,8"
                    Height="44"
                    Cursor="Hand"
                    Content="確認">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource AccentPrimary}" CornerRadius="8" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="White" TextBlock.FontSize="14" TextBlock.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 取消（確認模式用） -->
            <Button x:Name="CancelButton"
                    Click="CancelButton_Click"
                    Visibility="Collapsed"
                    Height="40"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource BgTertiary}" CornerRadius="8" BorderThickness="0">
                            <TextBlock Text="取消" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 關閉 -->
            <Button x:Name="CloseButton"
                    Click="CloseButton_Click"
                    Height="40"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{DynamicResource BgTertiary}" CornerRadius="8" BorderThickness="0">
                                <TextBlock Text="關閉" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
