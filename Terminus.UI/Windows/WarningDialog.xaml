<Window x:Class="Terminus.UI.Windows.WarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Nav_AppName}"
        Width="460" Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing">

    <!-- 玻璃卡片：環境光 + 面光 + 1px 白色描邊 -->
    <Border Background="{DynamicResource WindowAmbientGradient}"
            BorderBrush="{DynamicResource GlassStroke}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusWindow}">
        <Grid>
            <Grid IsHitTestVisible="False">
                <Ellipse Width="420" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-170,-160,0,0" Fill="{DynamicResource AmbientIndigo}"/>
                <Ellipse Width="380" Height="300" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-150,-140" Fill="{DynamicResource AmbientPink}"/>
            </Grid>

            <StackPanel Margin="26,24,26,26">

                <!-- Icon + Title -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="46" Height="46"
                            CornerRadius="14"
                            Background="{DynamicResource GlassFaceStrong}"
                            BorderBrush="{DynamicResource GlassStroke}"
                            BorderThickness="1"
                            Margin="0,0,14,0">
                        <TextBlock x:Name="IconText" Text="⚠️" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText"
                               FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Message -->
                <TextBlock x:Name="MessageText"
                           FontSize="13.5"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,0,0,14"/>

                <!-- Quota Info -->
                <Border x:Name="QuotaBorder"
                        Background="{DynamicResource BgTertiary}"
                        CornerRadius="12"
                        Padding="14,10"
                        Margin="0,0,0,18">
                    <TextBlock x:Name="QuotaText"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiary}"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Action Buttons -->
                <StackPanel x:Name="ButtonPanel">

                    <!-- 延遲選項（依配額顯示） -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="Delay30Button" Grid.Column="0" Margin="0,0,4,0"
                                Click="DelayButton_Click"
                                Height="44"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Warning_Delay30}"/>
                        <Button x:Name="Delay60Button" Grid.Column="1" Margin="4,0,4,0"
                                Click="DelayButton_Click"
                                Height="44"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Warning_Delay60}"/>
                        <Button x:Name="Delay90Button" Grid.Column="2" Margin="4,0,0,0"
                                Click="DelayButton_Click"
                                Height="44"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Warning_Delay90}"/>
                    </Grid>

                    <!-- 自訂分鐘延後 -->
                    <Button x:Name="DelayCustomButton"
                            Click="DelayCustomButton_Click"
                            Margin="0,0,0,8"
                            Height="44"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource Warning_DelayCustom}"/>

                    <!-- 自訂延後輸入區（隱藏，點擊自訂按鈕後顯示） -->
                    <StackPanel x:Name="CustomDelayPanel" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Warning_CustomDelayPrompt}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="2,0,0,8"/>
                        <TextBox x:Name="CustomDelayInput"
                                 Height="44"
                                 FontSize="15"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource DefaultTextBoxStyle}"
                                 PreviewTextInput="CustomDelayInput_PreviewTextInput"
                                 DataObject.Pasting="CustomDelayInput_Pasting"
                                 Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CustomDelayConfirmButton" Grid.Column="0" Margin="0,0,4,0"
                                    Click="CustomDelayConfirmButton_Click"
                                    Height="44"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{DynamicResource Common_Confirm}"/>
                            <Button x:Name="CustomDelayCancelButton" Grid.Column="1" Margin="4,0,0,0"
                                    Click="CustomDelayCancelButton_Click"
                                    Height="44"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{DynamicResource Common_Cancel}"/>
                        </Grid>
                    </StackPanel>

                    <!-- 立即關機 -->
                    <Button x:Name="ShutdownButton"
                            Click="ShutdownButton_Click"
                            Margin="0,0,0,8"
                            Height="44"
                            Style="{StaticResource DestructiveButtonStyle}"
                            Content="{DynamicResource Warning_ShutdownNow}"/>

                    <!-- 確認（確認模式用） -->
                    <Button x:Name="ConfirmButton"
                            Click="ConfirmButton_Click"
                            Visibility="Collapsed"
                            Margin="0,0,0,8"
                            Height="44"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Common_Confirm}"/>

                    <!-- 取消（確認模式用） -->
                    <Button x:Name="CancelButton"
                            Click="CancelButton_Click"
                            Visibility="Collapsed"
                            Height="42"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource Common_Cancel}"/>

                    <!-- 關閉 -->
                    <Button x:Name="CloseButton"
                            Click="CloseButton_Click"
                            Height="42"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource Common_Close}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
