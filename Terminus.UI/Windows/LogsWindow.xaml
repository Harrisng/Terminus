<Window x:Class="Terminus.UI.Windows.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Logs_Title}"
        Width="900" Height="600"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowAmbientGradient}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14,16,12">
            <DockPanel>
                <TextBlock Text="{DynamicResource Logs_Title}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBlock x:Name="LogPathText" Text="" FontSize="10.5" Foreground="{DynamicResource TextTertiary}"
                           VerticalAlignment="Center" Margin="14,1,0,0" DockPanel.Dock="Left"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton" Content="{DynamicResource Logs_Refresh}"
                            Height="32" Margin="0,0,8,0" Click="RefreshButton_Click"
                            Style="{StaticResource TextButtonStyle}"/>
                    <Button x:Name="ClearButton" Content="{DynamicResource Logs_Clear}"
                            Height="32" Click="ClearButton_Click"
                            Style="{StaticResource DestructiveButtonStyle}"
                            Padding="14,0" MinHeight="0" FontWeight="Medium"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Log Content -->
        <Border Grid.Row="1"
                Background="{DynamicResource GlassFace}"
                BorderBrush="{DynamicResource GlassStroke}"
                BorderThickness="1"
                CornerRadius="16"
                Margin="20,0,20,12"
                Padding="2">
            <TextBox x:Name="LogTextBox"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="Transparent"
                     Foreground="{DynamicResource TextSecondary}"
                     FontFamily="Consolas, 'Cascadia Mono', monospace"
                     FontSize="12"
                     BorderThickness="0"
                     Padding="12,10"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"/>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,0,20,12">
            <TextBlock x:Name="StatusText" Text="{DynamicResource Logs_Ready}" FontSize="11"
                       Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Left"/>
        </Border>
    </Grid>
</Window>
