<Window x:Class="Terminus.UI.Windows.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Logs_Title}"
        Width="900" Height="600"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimary}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Padding="16,12" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="{DynamicResource Logs_Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBlock x:Name="LogPathText" Text="" FontSize="11" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="16,0,0,0" DockPanel.Dock="Left" TextTrimming="CharacterEllipsis"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton" Content="{DynamicResource Logs_Refresh}" Width="80" Height="32" Margin="0,0,8,0" Click="RefreshButton_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{DynamicResource BgTertiary}" CornerRadius="6" BorderThickness="0">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="ClearButton" Content="{DynamicResource Logs_Clear}" Width="80" Height="32" Click="ClearButton_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{DynamicResource BgTertiary}" CornerRadius="6" BorderThickness="0">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{DynamicResource StatusError}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Log Content -->
        <Border Grid.Row="1" Background="{DynamicResource BgSidebar}" Margin="12,8,12,8" CornerRadius="8" Padding="4">
            <TextBox x:Name="LogTextBox"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="{DynamicResource BgSidebar}"
                     Foreground="{DynamicResource StatusSuccess}"
                     FontFamily="Consolas, 'Cascadia Mono', monospace"
                     FontSize="12"
                     BorderThickness="0"
                     Padding="8"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"/>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" Padding="16,8" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="{DynamicResource Logs_Ready}" FontSize="11" Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Left"/>
        </Border>
    </Grid>
</Window>
