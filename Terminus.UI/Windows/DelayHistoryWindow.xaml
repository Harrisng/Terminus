<Window x:Class="Terminus.UI.Windows.DelayHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource History_Title}"
        Width="680" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowAmbientGradient}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14,20,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource History_Title}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <TextBlock x:Name="CycleIdText" Text="" FontSize="11"
                           Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                           Margin="14,1,0,0"/>
            </StackPanel>
        </Border>

        <!-- History List -->
        <Border Grid.Row="1"
                Background="{DynamicResource GlassFace}"
                BorderBrush="{DynamicResource GlassStroke}"
                BorderThickness="1"
                CornerRadius="16"
                Margin="20,0,20,12"
                Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="HistoryPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,0,20,12">
            <TextBlock x:Name="StatusText" Text="{DynamicResource Logs_Ready}" FontSize="11"
                       Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Left"/>
        </Border>
    </Grid>
</Window>
