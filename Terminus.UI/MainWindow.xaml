<Window x:Class="Terminus.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Nav_AppSubtitle}"
        Width="1000" Height="650"
        MinWidth="800" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource BgPrimary}">

    <Border Background="{DynamicResource BgPrimary}" BorderThickness="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sidebar Header -->
            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,1,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource AccentGradient}">
                        <TextBlock Text="🌙" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Nav_AppName}"
                               FontSize="{StaticResource FontSizeBase}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Title Bar -->
            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BgHeader}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,0,1">
                <TextBlock x:Name="PageTitle"
                           Text="{DynamicResource Nav_Dashboard}"
                           FontSize="{StaticResource FontSizeBase}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
            </Border>

            <!-- Sidebar -->
            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource Nav_MainMenu}"
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontWeight="SemiBold"
                                   Margin="24,0,24,8"/>

                        <Button x:Name="NavDashboard"
                                Style="{StaticResource NavItemActiveStyle}"
                                Click="NavDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource Nav_Dashboard}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavCalendar"
                                Style="{StaticResource NavItemStyle}"
                                Click="NavCalendar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource Nav_Calendar}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavSettings"
                                Style="{StaticResource NavItemStyle}"
                                Click="NavSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource Nav_Settings}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
                        <Border Height="1" Background="{DynamicResource BorderPrimary}" Margin="16,8,16,10"/>
                        <Button x:Name="ThemeToggleButton"
                                Style="{StaticResource BottomActionStyle}"
                                Click="ThemeToggleButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ThemeIcon" Text="🌙" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="ThemeText" Text="{DynamicResource Nav_DarkMode}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource BottomActionStyle}"
                                Click="MinimizeButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Nav_MinimizeToTray}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Frame x:Name="MainFrame"
                       NavigationUIVisibility="Hidden"
                       Background="{DynamicResource BgPrimary}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
