<Page x:Class="Terminus.UI.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Background="{DynamicResource BgPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- Header -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Nav_Dashboard}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="CurrentDateText" Text="--" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <!-- Hero Status Card -->
            <Border Style="{StaticResource CardStyle}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status Indicator + State Text -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StateIndicator" Width="14" Height="14" Fill="{DynamicResource StatusIdle}" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#7c6df2" Opacity="0.6" BlurRadius="10" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="StateText" Text="{DynamicResource State_Idle}"
                                   FontSize="{StaticResource FontSize4XL}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource StatusIdle}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Next Action Time -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard_NextActionLabel}"
                                   Style="{StaticResource CardLabelStyle}"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="NextActionText" Text="--"
                                   FontSize="{StaticResource FontSizeXL}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats Cards Row -->
            <UniformGrid Columns="3" Margin="0,0,0,16">

                <!-- Quota Card -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_QuotaLabel}"
                                   Style="{StaticResource CardLabelStyle}"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="QuotaText" Text="{DynamicResource Dashboard_Unlimited}"
                                   Style="{StaticResource MetricValueStyle}"
                                   Foreground="{DynamicResource StatusSuccess}"/>
                    </StackPanel>
                </Border>

                <!-- Today's Cycle Card -->
                <Border Style="{StaticResource CardStyle}" Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_CycleIdLabel}"
                                   Style="{StaticResource CardLabelStyle}"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="CycleIdText" Text="--"
                                   FontSize="{StaticResource FontSize2XL}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="DelayCountText" Text="--"
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Next Warning Card -->
                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_WarningTimeLabel}"
                                   Style="{StaticResource CardLabelStyle}"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="WarningTimeText" Text="--"
                                   Style="{StaticResource MetricValueStyle}"
                                   Foreground="{DynamicResource StatusWarning}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Tomorrow Info Card -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: First Class Time -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard_TomorrowClassLabel}"
                                   Style="{StaticResource CardLabelStyle}"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="TomorrowClassTimeText" Text="--"
                                   Style="{StaticResource MetricValueStyle}"/>
                    </StackPanel>

                    <!-- Right: Classification with color indicator -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Ellipse x:Name="ClassificationIndicator" Width="10" Height="10" Fill="{DynamicResource AccentPrimary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ClassificationText" Text="{DynamicResource Classification_NonEarlyClass}"
                                   FontSize="{StaticResource FontSizeLG}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentPrimary}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick Actions -->
            <TextBlock Text="{DynamicResource Dashboard_QuickActions}" Style="{StaticResource SectionTitleStyle}"/>

            <WrapPanel Orientation="Horizontal">
                <Button x:Name="DelayButton" Content="{DynamicResource Warning_Delay30}"
                        Width="180" Height="50"
                        Margin="0,0,12,12"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="DelayButton_Click"/>

                <Button x:Name="ShutdownNowButton" Content="{DynamicResource Warning_ShutdownNow}"
                        Width="180" Height="50"
                        Margin="0,0,12,12"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="ShutdownNowButton_Click"/>

                <Button x:Name="AIModeButton" Content="{DynamicResource Warning_AIMode}"
                        Width="180" Height="50"
                        Margin="0,0,12,12"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AIModeButton_Click"/>
            </WrapPanel>

            <!-- Next Schedule Preview -->
            <TextBlock Text="{DynamicResource Dashboard_SchedulePreviewLabel}" Style="{StaticResource SectionTitleStyle}"/>

            <Border Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel x:Name="SchedulePanel">
                    <!-- Schedule items will be added programmatically -->
                    <TextBlock Text="{DynamicResource Dashboard_Loading}"
                               FontSize="{StaticResource FontSizeBase}"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
