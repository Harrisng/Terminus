<Page x:Class="Terminus.UI.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,36" MaxWidth="1080">

            <!-- Header -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Nav_Dashboard}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="CurrentDateText" Text="--" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <!-- ══════ Hero 狀態卡 ══════ -->
            <Border Style="{StaticResource HeroCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：目前狀態 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard_StateLabel}"
                                   Style="{StaticResource CardLabelStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Ellipse x:Name="StateIndicator" Width="10" Height="10"
                                     Fill="{DynamicResource StatusIdle}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StateText" Text="{DynamicResource State_Idle}"
                                       FontSize="38"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource StatusIdle}"
                                       Margin="11,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="HeroNoteText" Text=""
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,9,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 右：下次動作 -->
                    <Border Grid.Column="1" Margin="28,0,0,0" Padding="26,0,0,0"
                            BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource GlassStroke}"
                            VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Dashboard_NextActionLabel}"
                                       Style="{StaticResource CardLabelStyle}"/>
                            <TextBlock x:Name="NextActionText" Text="--"
                                       FontSize="56"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,2,0,0"/>
                            <TextBlock x:Name="CountdownText" Text=""
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <TextBlock Text="{DynamicResource Dashboard_CycleIdLabel}"
                                           Style="{StaticResource CardMetaStyle}" FontSize="11"/>
                                <TextBlock x:Name="CycleIdText" Text="--"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextTertiary}"
                                           Margin="7,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════ 今晚作息 ══════ -->
            <TextBlock Text="{DynamicResource Dashboard_TonightRoutine}" Style="{StaticResource SectionTitleStyle}"/>

            <Border x:Name="RoutineCard" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Name="TimelineSummaryText" Text=""
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"/>

                    <!-- 時間軸色塊（程式動態生成） -->
                    <Grid x:Name="TimelineSegments" Height="14" Margin="0,14,0,0"/>

                    <!-- 圖例 -->
                    <WrapPanel Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SegmentBuffer}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Dashboard_RoutineBuffer}" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiary}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SegmentSleep}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Dashboard_RoutineSleep}" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiary}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SegmentWash}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Dashboard_RoutineWash}" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiary}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SegmentBreakfast}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Dashboard_RoutineBreakfast}" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiary}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SegmentCommute}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Dashboard_RoutineCommute}" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiary}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ══════ 即時數據 ══════ -->
            <TextBlock Text="{DynamicResource Dashboard_LiveStats}" Style="{StaticResource SectionTitleStyle}"/>

            <UniformGrid Columns="3" Margin="0,0,0,4">

                <!-- 剩餘配額 -->
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_QuotaLabel}"
                                   Style="{StaticResource CardLabelStyle}"/>
                        <TextBlock x:Name="QuotaText" Text="{DynamicResource Dashboard_Unlimited}"
                                   Style="{StaticResource MetricValueStyle}"
                                   Foreground="{DynamicResource StatusSuccess}"
                                   Margin="0,6,0,0"/>

                        <Border x:Name="QuotaMeterTrack" Height="5" CornerRadius="3"
                                Background="{DynamicResource BgTertiary}"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="QuotaFillColumn" Width="1*"/>
                                    <ColumnDefinition x:Name="QuotaRestColumn" Width="0*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3"
                                        Background="{DynamicResource AccentPrimary}"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="DelayCountText" Text="--"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiary}"
                                   Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 下次預警 -->
                <Border Style="{StaticResource StatCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_WarningTimeLabel}"
                                   Style="{StaticResource CardLabelStyle}"/>
                        <TextBlock x:Name="WarningTimeText" Text="--"
                                   Style="{StaticResource MetricValueStyle}"
                                   Foreground="{DynamicResource StatusWarning}"
                                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="WarningLeadText" Text=""
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiary}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 明日首課 -->
                <Border Style="{StaticResource StatCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_TomorrowClassLabel}"
                                   Style="{StaticResource CardLabelStyle}"/>
                        <TextBlock x:Name="TomorrowClassTimeText" Text="--"
                                   Style="{StaticResource MetricValueStyle}"
                                   Margin="0,6,0,0"/>
                        <Border x:Name="ClassificationBadge"
                                Style="{StaticResource BadgeEarlyBorderStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ClassificationIndicator" Width="6" Height="6"
                                         Fill="{DynamicResource AccentPrimary}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ClassificationText" Text="{DynamicResource Classification_NonEarlyClass}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentPrimary}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ══════ 快速操作 ══════ -->
            <TextBlock Text="{DynamicResource Dashboard_QuickActions}" Style="{StaticResource SectionTitleStyle}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="DelayButton" Content="{DynamicResource Warning_Delay30}"
                        Margin="0,0,10,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="DelayButton_Click"/>

                <Button x:Name="AIModeButton" Content="{DynamicResource Warning_AIMode}"
                        Margin="0,0,10,0"
                        Style="{StaticResource TintedButtonStyle}"
                        Click="AIModeButton_Click"/>

                <Button x:Name="ShutdownNowButton" Content="{DynamicResource Warning_ShutdownNow}"
                        Style="{StaticResource DestructiveButtonStyle}"
                        Click="ShutdownNowButton_Click"/>
            </StackPanel>

            <!-- ══════ 未來 7 天 ══════ -->
            <TextBlock Text="{DynamicResource Dashboard_SchedulePreviewLabel}" Style="{StaticResource SectionTitleStyle}"/>

            <Border Style="{StaticResource GlassListStyle}">
                <StackPanel x:Name="SchedulePanel">
                    <TextBlock Text="{DynamicResource Dashboard_Loading}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,12"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
