<Page x:Class="Terminus.UI.Pages.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主要月曆區 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,26,30,28" MaxWidth="1080">

                <!-- 標題 + 檢視切換 -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="PageTitleText" Text="月曆" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock x:Name="PageSubtitleText" Text="點擊日期查看課程詳情" Style="{StaticResource PageSubtitleStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="1" VerticalAlignment="Center"
                            Background="{DynamicResource GlassFaceStrong}"
                            BorderBrush="{DynamicResource GlassStroke}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="MonthViewButton" Content="月"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="MonthViewButton_Click"/>
                            <Button x:Name="WeekViewButton" Content="週"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="WeekViewButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 月份標題 + 導覽 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="MonthTitleText" Text="2026年9月"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Style="{StaticResource IconButtonStyle}" Click="PrevButton_Click">
                            <Path Data="M8.3 2.2 L3.5 7 L8.3 11.8"
                                  Style="{StaticResource InlineIconStyle}"
                                  Width="12" Height="12" StrokeThickness="1.8"/>
                        </Button>
                        <Button x:Name="TodayButton" Content="今天"
                                Style="{StaticResource TextButtonStyle}"
                                Margin="6,0" Click="TodayButton_Click"/>
                        <Button x:Name="NextButton" Style="{StaticResource IconButtonStyle}" Click="NextButton_Click">
                            <Path Data="M3.7 2.2 L8.5 7 L3.7 11.8"
                                  Style="{StaticResource InlineIconStyle}"
                                  Width="12" Height="12" StrokeThickness="1.8"/>
                        </Button>
                        <Button x:Name="RefreshButton" Style="{StaticResource IconButtonStyle}"
                                Margin="6,0,0,0"
                                ToolTip="{DynamicResource Calendar_Refresh}"
                                Click="RefreshButton_Click">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{DynamicResource TextSecondary}"
                                  Stretch="Uniform"
                                  Width="13" Height="13"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 月檢視 -->
                <Border x:Name="MonthViewBorder" Style="{StaticResource CardStyle}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="DayHeadersGrid" Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <Grid x:Name="CalendarGrid" Grid.Row="1"/>
                    </Grid>
                </Border>

                <!-- 週檢視 -->
                <Border x:Name="WeekViewBorder" Style="{StaticResource CardStyle}" Padding="0" Visibility="Collapsed" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource BgHeader}"
                                BorderBrush="{DynamicResource BorderSecondary}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="19,19,0,0">
                            <Grid x:Name="WeekHeadersGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="WeekTimeGrid" MinHeight="500"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 單日課程詳情 -->
        <Border x:Name="DetailPanel" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource GlassFaceStrong}"
                BorderBrush="{DynamicResource GlassStroke}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="22,16"
                Margin="30,0,30,20"
                MaxHeight="260">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="DetailDateText" Grid.Row="0" Grid.Column="0" Text=""
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>

                <Button x:Name="CloseDetailButton" Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Click="CloseDetailButton_Click" VerticalAlignment="Top">
                    <Path Data="M3.5 3.5 L10.5 10.5 M10.5 3.5 L3.5 10.5"
                          Style="{StaticResource InlineIconStyle}"
                          Width="11" Height="11" StrokeThickness="1.7"/>
                </Button>

                <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              VerticalScrollBarVisibility="Auto" MaxHeight="200" Margin="0,10,0,0">
                    <StackPanel x:Name="EventListPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
