<Page x:Class="Terminus.UI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Background="{DynamicResource BgPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">

            <!-- Header -->
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="設定" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="自訂你的睡眠週期參數" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <!-- Calendar Settings Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="日曆設定" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="日曆 URL"
                               Style="{StaticResource CardLabelStyle}"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="CalendarUrlTextBox"
                             MinHeight="48"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             VerticalAlignment="Stretch"
                             Style="{StaticResource DefaultTextBoxStyle}"/>
                    <TextBlock Text="從 ITP Moodle 日曆獲取 webcal:// 或 https:// 地址"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="4,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Time Buffer Settings Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="時間緩衝設定" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="總計預設：9 小時 15 分鐘"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Sleep Time -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="睡眠時間"
                                   FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,12">
                            <TextBox x:Name="SleepTimeTextBox"
                                     Width="80"
                                     MinHeight="40"
                                     Padding="8,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                            <TextBlock Text="分鐘" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Pre-sleep Buffer -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="睡前準備"
                                   FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,12">
                            <TextBox x:Name="PreSleepTextBox"
                                     Width="80"
                                     MinHeight="40"
                                     Padding="8,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                            <TextBlock Text="分鐘" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Wash Time -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="梳洗"
                                   FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,12">
                            <TextBox x:Name="WashTextBox"
                                     Width="80"
                                     MinHeight="40"
                                     Padding="8,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                            <TextBlock Text="分鐘" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Breakfast Time -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="早餐"
                                   FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,12">
                            <TextBox x:Name="BreakfastTextBox"
                                     Width="80"
                                     MinHeight="40"
                                     Padding="8,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                            <TextBlock Text="分鐘" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Commute Time -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="通勤"
                                   FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBox x:Name="CommuteTextBox"
                                     Width="80"
                                     MinHeight="40"
                                     Padding="8,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                            <TextBlock Text="分鐘" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- General Settings Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="一般設定" Style="{StaticResource CardTitleStyle}"/>

                    <!-- Start with Windows -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="開機啟動"
                                       FontSize="{StaticResource FontSizeBase}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="開機時自動啟動 Terminus"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Grid.Column="1"
                                  Style="{StaticResource DefaultCheckBoxStyle}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  IsChecked="True"/>
                    </Grid>

                    <!-- Dark Mode -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="深色模式"
                                       FontSize="{StaticResource FontSizeBase}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="切換淺色／深色主題"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="DarkModeCheckBox"
                                  Grid.Column="1"
                                  Style="{StaticResource DefaultCheckBoxStyle}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  IsChecked="True"
                                  Checked="DarkModeCheckBox_Checked"
                                  Unchecked="DarkModeCheckBox_Unchecked"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cache Management Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="快取管理" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="清除所有快取的日曆數據，下次啟動時將重新抓取。"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,0,0,16"/>
                    <Button x:Name="ClearCacheButton"
                            Content="清除快取"
                            Width="120" Height="36"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ClearCacheButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Diagnostics Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="診斷工具" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="查看系統日誌，排查日曆載入等問題。"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,0,0,16"/>
                    <Button x:Name="ViewLogsButton"
                            Content="查看日誌"
                            Width="120" Height="36"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ViewLogsButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Save Button -->
            <Button x:Name="SaveButton"
                    Content="儲存設定"
                    Height="44"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"/>

        </StackPanel>
    </ScrollViewer>
</Page>
