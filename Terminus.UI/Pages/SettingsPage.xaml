<Page x:Class="Terminus.UI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Background="{DynamicResource BgPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">

            <!-- Header -->
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="{DynamicResource Settings_Title}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{DynamicResource Settings_Subtitle}" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <!-- Language Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_LanguageCardTitle}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings_LanguageCardDesc}"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,0,0,16"/>
                    <ComboBox x:Name="LanguageComboBox"
                              MinHeight="40"
                              Padding="8,0"
                              VerticalContentAlignment="Center"
                              Style="{StaticResource DefaultComboBoxStyle}"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem x:Name="LangZhTWItem" Content="{DynamicResource Settings_Language_zhTW}" Tag="zh-TW"/>
                        <ComboBoxItem x:Name="LangEnUSItem" Content="{DynamicResource Settings_Language_enUS}" Tag="en-US"/>
                        <ComboBoxItem x:Name="LangZhCNItem" Content="{DynamicResource Settings_Language_zhCN}" Tag="zh-CN"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Calendar Settings Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_CalendarCardTitle}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings_CalendarUrlLabel}"
                               Style="{StaticResource CardLabelStyle}"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="CalendarUrlTextBox"
                             MinHeight="48"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             VerticalAlignment="Stretch"
                             Style="{StaticResource DefaultTextBoxStyle}"/>
                    <TextBlock Text="{DynamicResource Settings_CalendarUrlHint}"
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="4,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Time Buffer Settings Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_SleepCardTitle}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings_SleepCardDesc}"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Sleep Time -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_SleepTimeLabel}"
                                   FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,12">
                            <TextBox x:Name="SleepTimeTextBox"
                                     Width="80"
                                     MinHeight="40"
                                     Padding="8,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                            <TextBlock Text="{DynamicResource Common_Minutes}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Pre-sleep Buffer -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_PreSleepLabel}"
                                   FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,12">
                            <TextBox x:Name="PreSleepTextBox"
                                     Width="80"
                                     MinHeight="40"
                                     Padding="8,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                            <TextBlock Text="{DynamicResource Common_Minutes}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Wash Time -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings_WashTimeLabel}"
                                   FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,12">
                            <TextBox x:Name="WashTextBox"
                                     Width="80"
                                     MinHeight="40"
                                     Padding="8,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                            <TextBlock Text="{DynamicResource Common_Minutes}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Breakfast Time -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Settings_BreakfastTimeLabel}"
                                   FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,12">
                            <TextBox x:Name="BreakfastTextBox"
                                     Width="80"
                                     MinHeight="40"
                                     Padding="8,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                            <TextBlock Text="{DynamicResource Common_Minutes}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Commute Time -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Settings_CommuteTimeLabel}"
                                   FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBox x:Name="CommuteTextBox"
                                     Width="80"
                                     MinHeight="40"
                                     Padding="8,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                            <TextBlock Text="{DynamicResource Common_Minutes}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Early Class Classification Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_EarlyClassCardTitle}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings_EarlyClassCardDesc}"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cutoff Hour -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_EarlyClassCutoffLabel}"
                                       FontSize="{StaticResource FontSizeBase}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource Settings_EarlyClassCutoffHint}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBox x:Name="CutoffHourTextBox"
                                     Width="80"
                                     MinHeight="40"
                                     Padding="8,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                            <TextBlock Text="{DynamicResource Settings_HourUnit}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Delay Quota -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock Text="{DynamicResource Settings_EarlyClassQuotaLabel}"
                                       FontSize="{StaticResource FontSizeBase}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource Settings_EarlyClassQuotaHint}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,12,0,0">
                            <TextBox x:Name="DelayQuotaTextBox"
                                     Width="80"
                                     MinHeight="40"
                                     Padding="8,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                            <TextBlock Text="{DynamicResource Common_Minutes}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- General Settings Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_GeneralCardTitle}" Style="{StaticResource CardTitleStyle}"/>

                    <!-- Start with Windows -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_StartWithWindows}"
                                       FontSize="{StaticResource FontSizeBase}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource Settings_StartWithWindowsHint}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Grid.Column="1"
                                  Style="{StaticResource DefaultCheckBoxStyle}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  IsChecked="True"/>
                    </Grid>

                    <!-- Dark Mode -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Nav_DarkMode}"
                                       FontSize="{StaticResource FontSizeBase}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource Settings_DarkModeHint}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="DarkModeCheckBox"
                                  Grid.Column="1"
                                  Style="{StaticResource DefaultCheckBoxStyle}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  IsChecked="True"
                                  Checked="DarkModeCheckBox_Checked"
                                  Unchecked="DarkModeCheckBox_Unchecked"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cache Management Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_CacheCardTitle}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings_CacheCardDesc}"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,0,0,16"/>
                    <Button x:Name="ClearCacheButton"
                            Content="{DynamicResource Settings_ClearCache}"
                            Width="120" Height="36"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ClearCacheButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Diagnostics Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_DiagnosticsCardTitle}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings_DiagnosticsCardDesc}"
                               FontSize="{StaticResource FontSizeSM}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="ViewLogsButton"
                                Content="{DynamicResource Settings_ViewLogs}"
                                Width="120" Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ViewLogsButton_Click"/>
                        <Button x:Name="ViewDelayHistoryButton"
                                Content="{DynamicResource Settings_ViewHistory}"
                                Width="130" Height="36"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ViewDelayHistoryButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Save Button -->
            <Button x:Name="SaveButton"
                    Content="{DynamicResource Common_Save}"
                    Height="44"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"/>

        </StackPanel>
    </ScrollViewer>
</Page>
