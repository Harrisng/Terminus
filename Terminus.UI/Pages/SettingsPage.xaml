<Page x:Class="Terminus.UI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,36" MaxWidth="820">

            <!-- Header -->
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource Settings_Title}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{DynamicResource Settings_Subtitle}" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <!-- ══════ 語言 ══════ -->
            <TextBlock Text="{DynamicResource Settings_LanguageCardTitle}" Style="{StaticResource SectionTitleStyle}"/>
            <Border Style="{StaticResource GlassGroupStyle}">
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Settings_LanguageCardDesc}"
                                   Style="{StaticResource RowLabelStyle}"
                                   FontWeight="Normal"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="LanguageComboBox"
                                  Grid.Column="1"
                                  Width="180"
                                  Style="{StaticResource DefaultComboBoxStyle}"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="LangZhTWItem" Content="{DynamicResource Settings_Language_zhTW}" Tag="zh-TW"/>
                            <ComboBoxItem x:Name="LangEnUSItem" Content="{DynamicResource Settings_Language_enUS}" Tag="en-US"/>
                            <ComboBoxItem x:Name="LangZhCNItem" Content="{DynamicResource Settings_Language_zhCN}" Tag="zh-CN"/>
                        </ComboBox>
                    </Grid>
                </Border>
            </Border>

            <!-- ══════ 日曆來源 ══════ -->
            <TextBlock Text="{DynamicResource Settings_CalendarCardTitle}" Style="{StaticResource SectionTitleStyle}"/>
            <Border Style="{StaticResource GlassGroupStyle}">
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_CalendarUrlLabel}"
                                       Style="{StaticResource RowLabelStyle}"/>
                            <TextBlock Text="{DynamicResource Settings_CalendarUrlHint}"
                                       Style="{StaticResource RowHintStyle}"/>
                        </StackPanel>
                        <TextBox x:Name="CalendarUrlTextBox"
                                 Grid.Column="1"
                                 Width="380"
                                 Style="{StaticResource DefaultTextBoxStyle}"/>
                    </Grid>
                </Border>
            </Border>

            <!-- ══════ 睡眠設定 ══════ -->
            <TextBlock Text="{DynamicResource Settings_SleepCardTitle}" Style="{StaticResource SectionTitleStyle}"/>
            <Border Style="{StaticResource GlassGroupStyle}">
                <StackPanel>

                <!-- 時間軸預覽 -->
                <Border Padding="18,15,18,15">
                    <StackPanel>
                        <TextBlock x:Name="SleepTimelineSummary"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <Border CornerRadius="14" ClipToBounds="True"
                                Background="{DynamicResource BgTertiary}">
                            <Canvas x:Name="TimelineCanvas"
                                    Height="108"
                                    Background="Transparent"
                                    ClipToBounds="True"
                                    SizeChanged="TimelineCanvas_SizeChanged"
                                    MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                                    MouseMove="TimelineCanvas_MouseMove"
                                    MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp"
                                    MouseLeave="TimelineCanvas_MouseLeave"/>
                        </Border>

                        <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SegmentBuffer}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Settings_PreSleepLabel}"
                                           Margin="6,0,4,0" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="LegendBufferDuration" Text="--"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TextTertiary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SegmentSleep}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Settings_SleepTimeLabel}"
                                           Margin="6,0,4,0" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="LegendSleepDuration" Text="--"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TextTertiary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SegmentWash}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Settings_WashTimeLabel}"
                                           Margin="6,0,4,0" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="LegendWashDuration" Text="--"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TextTertiary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SegmentBreakfast}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Settings_BreakfastTimeLabel}"
                                           Margin="6,0,4,0" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="LegendBreakfastDuration" Text="--"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TextTertiary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SegmentCommute}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Settings_CommuteTimeLabel}"
                                           Margin="6,0,4,0" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="LegendCommuteDuration" Text="--"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TextTertiary}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingRowDividerStyle}"/>

                <!-- 睡眠時長 -->
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_SleepTimeLabel}"
                                   Style="{StaticResource RowLabelStyle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="SleepHoursTextBox" Width="72"
                                     Style="{StaticResource DefaultTextBoxStyle}"
                                     Padding="6,0"
                                     HorizontalContentAlignment="Center"
                                     TextChanged="SleepInput_TextChanged"/>
                            <TextBlock Text="{DynamicResource Settings_HourUnit}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="8,0,10,0"/>
                            <TextBox x:Name="SleepMinutesTextBox" Width="72"
                                     Style="{StaticResource DefaultTextBoxStyle}"
                                     Padding="6,0"
                                     HorizontalContentAlignment="Center"
                                     TextChanged="SleepInput_TextChanged"/>
                            <TextBlock Text="{DynamicResource Common_Minutes}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRowDividerStyle}"/>

                <!-- 前置緩衝 -->
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_PreSleepLabel}"
                                   Style="{StaticResource RowLabelStyle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="PreSleepTextBox" Width="72"
                                     Style="{StaticResource DefaultTextBoxStyle}"
                                     Padding="6,0"
                                     HorizontalContentAlignment="Center"
                                     TextChanged="SleepInput_TextChanged"/>
                            <TextBlock Text="{DynamicResource Common_Minutes}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRowDividerStyle}"/>

                <!-- 洗漱時間 -->
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_WashTimeLabel}"
                                   Style="{StaticResource RowLabelStyle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="WashTextBox" Width="72"
                                     Style="{StaticResource DefaultTextBoxStyle}"
                                     Padding="6,0"
                                     HorizontalContentAlignment="Center"
                                     TextChanged="SleepInput_TextChanged"/>
                            <TextBlock Text="{DynamicResource Common_Minutes}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRowDividerStyle}"/>

                <!-- 早餐時間 -->
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_BreakfastTimeLabel}"
                                   Style="{StaticResource RowLabelStyle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="BreakfastTextBox" Width="72"
                                     Style="{StaticResource DefaultTextBoxStyle}"
                                     Padding="6,0"
                                     HorizontalContentAlignment="Center"
                                     TextChanged="SleepInput_TextChanged"/>
                            <TextBlock Text="{DynamicResource Common_Minutes}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRowDividerStyle}"/>

                <!-- 通勤時間 -->
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_CommuteTimeLabel}"
                                   Style="{StaticResource RowLabelStyle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="CommuteTextBox" Width="72"
                                     Style="{StaticResource DefaultTextBoxStyle}"
                                     Padding="6,0"
                                     HorizontalContentAlignment="Center"
                                     TextChanged="SleepInput_TextChanged"/>
                            <TextBlock Text="{DynamicResource Common_Minutes}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                </StackPanel>
            </Border>

            <!-- ══════ 早課判定 ══════ -->
            <TextBlock Text="{DynamicResource Settings_EarlyClassCardTitle}" Style="{StaticResource SectionTitleStyle}"/>
            <Border Style="{StaticResource GlassGroupStyle}">
                <StackPanel>
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_EarlyClassCutoffLabel}"
                                       Style="{StaticResource RowLabelStyle}"/>
                            <TextBlock Text="{DynamicResource Settings_EarlyClassCutoffHint}"
                                       Style="{StaticResource RowHintStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="CutoffHourTextBox" Width="72"
                                     Style="{StaticResource DefaultTextBoxStyle}"
                                     Padding="6,0"
                                     HorizontalContentAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Settings_HourUnit}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRowDividerStyle}"/>

                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_EarlyClassQuotaLabel}"
                                       Style="{StaticResource RowLabelStyle}"/>
                            <TextBlock Text="{DynamicResource Settings_EarlyClassQuotaHint}"
                                       Style="{StaticResource RowHintStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="DelayQuotaTextBox" Width="72"
                                     Style="{StaticResource DefaultTextBoxStyle}"
                                     Padding="6,0"
                                     HorizontalContentAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Common_Minutes}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                </StackPanel>
            </Border>

            <!-- ══════ 一般設定 ══════ -->
            <TextBlock Text="{DynamicResource Settings_GeneralCardTitle}" Style="{StaticResource SectionTitleStyle}"/>
            <Border Style="{StaticResource GlassGroupStyle}">
                <StackPanel>
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_StartWithWindows}"
                                       Style="{StaticResource RowLabelStyle}"/>
                            <TextBlock Text="{DynamicResource Settings_StartWithWindowsHint}"
                                       Style="{StaticResource RowHintStyle}"/>
                        </StackPanel>
                        <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="1"
                                  Style="{StaticResource DefaultCheckBoxStyle}"
                                  VerticalAlignment="Center" HorizontalAlignment="Right"
                                  IsChecked="True"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRowDividerStyle}"/>

                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Nav_DarkMode}"
                                       Style="{StaticResource RowLabelStyle}"/>
                            <TextBlock Text="{DynamicResource Settings_DarkModeHint}"
                                       Style="{StaticResource RowHintStyle}"/>
                        </StackPanel>
                        <CheckBox x:Name="DarkModeCheckBox" Grid.Column="1"
                                  Style="{StaticResource DefaultCheckBoxStyle}"
                                  VerticalAlignment="Center" HorizontalAlignment="Right"
                                  IsChecked="True"
                                  Checked="DarkModeCheckBox_Checked"
                                  Unchecked="DarkModeCheckBox_Unchecked"/>
                    </Grid>
                </Border>
                </StackPanel>
            </Border>

            <!-- ══════ 快取管理 ══════ -->
            <TextBlock Text="{DynamicResource Settings_CacheCardTitle}" Style="{StaticResource SectionTitleStyle}"/>
            <Border Style="{StaticResource GlassGroupStyle}">
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Settings_CacheCardDesc}"
                                   Style="{StaticResource RowHintStyle}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0"/>
                        <Button x:Name="ClearCacheButton" Grid.Column="1"
                                Content="{DynamicResource Settings_ClearCache}"
                                Style="{StaticResource TextButtonStyle}"
                                Click="ClearCacheButton_Click"/>
                    </Grid>
                </Border>
            </Border>

            <!-- ══════ 診斷工具 ══════ -->
            <TextBlock Text="{DynamicResource Settings_DiagnosticsCardTitle}" Style="{StaticResource SectionTitleStyle}"/>
            <Border Style="{StaticResource GlassGroupStyle}">
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Settings_DiagnosticsCardDesc}"
                                   Style="{StaticResource RowHintStyle}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ViewLogsButton"
                                    Content="{DynamicResource Settings_ViewLogs}"
                                    Style="{StaticResource TextButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="ViewLogsButton_Click"/>
                            <Button x:Name="ViewDelayHistoryButton"
                                    Content="{DynamicResource Settings_ViewHistory}"
                                    Style="{StaticResource TextButtonStyle}"
                                    Click="ViewDelayHistoryButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- 儲存 -->
            <Button x:Name="SaveButton"
                    Content="{DynamicResource Common_Save}"
                    Height="44"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"/>

        </StackPanel>
    </ScrollViewer>
</Page>
