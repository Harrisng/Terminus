<Window x:Class="Terminus.UI.AIModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AIMode_Title}"
        Width="560" Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- 玻璃卡片 -->
    <Border Background="{DynamicResource WindowAmbientGradient}"
            BorderBrush="{DynamicResource GlassStroke}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusWindow}">
        <Grid>
            <Grid IsHitTestVisible="False">
                <Ellipse Width="460" Height="340" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-190,-170,0,0" Fill="{DynamicResource AmbientIndigo}"/>
                <Ellipse Width="420" Height="320" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-170,-150" Fill="{DynamicResource AmbientCyan}"/>
            </Grid>

            <StackPanel Margin="26,24,26,26">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Width="46" Height="46"
                            CornerRadius="14"
                            Background="{DynamicResource GlassFaceStrong}"
                            BorderBrush="{DynamicResource GlassStroke}"
                            BorderThickness="1"
                            Margin="0,0,14,0">
                        <TextBlock Text="🤖" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource AIMode_Title}"
                               FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Running AI Processes Section -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource AIMode_RunningProcesses}"
                               Style="{StaticResource RowLabelStyle}"
                               FontSize="12.5"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource BgTertiary}"
                            BorderBrush="{DynamicResource GlassStrokeSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,11">
                        <TextBlock x:Name="RunningProcessesText"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="12.5"
                                   LineHeight="19"/>
                    </Border>
                </StackPanel>

                <!-- Monitor Button (shown when processes are running) -->
                <Button x:Name="MonitorButton"
                        Content="{DynamicResource AIMode_MonitorRunning}"
                        Height="42"
                        Margin="0,0,0,16"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="MonitorButton_Click"/>

                <!-- Divider -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" Background="{DynamicResource BorderPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource AIMode_OrLaunch}"
                               Foreground="{DynamicResource TextTertiary}"
                               FontSize="11"
                               Margin="12,0"/>
                    <Border Grid.Column="2" Height="1" Background="{DynamicResource BorderPrimary}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Command Line Input (manual launch) -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource AIMode_CommandLabel}"
                               Style="{StaticResource RowLabelStyle}"
                               FontSize="12.5"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="CommandLineTextBox"
                             Height="78"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             Padding="11,9"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource DefaultTextBoxStyle}"/>
                    <TextBlock Text="{DynamicResource AIMode_CommandHint}"
                               Style="{StaticResource RowHintStyle}"
                               Margin="2,6,0,0"/>
                </StackPanel>

                <!-- Working Directory + Description -->
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource AIMode_WorkDirLabel}"
                               Style="{StaticResource RowLabelStyle}"
                               FontSize="12.5"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="WorkDirTextBox"
                             Height="38"
                             TextWrapping="NoWrap"
                             Style="{StaticResource DefaultTextBoxStyle}"
                             Margin="0,0,0,14"/>

                    <TextBlock Text="{DynamicResource AIMode_DescriptionLabel}"
                               Style="{StaticResource RowLabelStyle}"
                               FontSize="12.5"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="DescriptionTextBox"
                             Height="38"
                             TextWrapping="NoWrap"
                             Style="{StaticResource DefaultTextBoxStyle}"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="StartButton" Content="{DynamicResource AIMode_Start}"
                            MinWidth="104" Height="42" Margin="0,0,10,0"
                            Style="{StaticResource PrimaryButtonStyle}" Click="StartButton_Click"/>
                    <Button x:Name="CancelButton" Content="{DynamicResource Common_Cancel}"
                            MinWidth="104" Height="42"
                            Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
