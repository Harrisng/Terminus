<Window x:Class="Terminus.UI.AIModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AIMode_Title}"
        Width="540" Height="Auto"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="Height"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource BgPrimary}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🤖" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource AIMode_Title}"
                       FontSize="{StaticResource FontSize2XL}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Running AI Processes Section -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource AIMode_RunningProcesses}"
                       FontSize="{StaticResource FontSizeBase}"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>
            <Border Background="{DynamicResource BgTertiary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <TextBlock x:Name="RunningProcessesText"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="13"/>
            </Border>
        </StackPanel>

        <!-- Monitor Button (shown when processes are running) -->
        <Button x:Name="MonitorButton" Grid.Row="2"
                Content="{DynamicResource AIMode_MonitorRunning}"
                Height="40"
                Margin="0,0,0,16"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="MonitorButton_Click"/>

        <!-- Divider -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="1" Background="{DynamicResource BorderPrimary}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource AIMode_OrLaunch}"
                       Foreground="{DynamicResource TextTertiary}"
                       FontSize="{StaticResource FontSizeSM}"
                       Margin="12,0"/>
            <Border Grid.Column="2" Height="1" Background="{DynamicResource BorderPrimary}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Command Line Input (manual launch) -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource AIMode_CommandLabel}"
                       FontSize="{StaticResource FontSizeBase}"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="CommandLineTextBox"
                     Height="64"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource DefaultTextBoxStyle}"
                     Foreground="{DynamicResource TextPrimary}"
                     Background="{DynamicResource BgInput}"/>
            <TextBlock Text="{DynamicResource AIMode_CommandHint}"
                       FontSize="{StaticResource FontSizeSM}"
                       Foreground="{DynamicResource TextTertiary}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Working Directory + Description -->
        <StackPanel Grid.Row="5" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource AIMode_WorkDirLabel}"
                       FontSize="{StaticResource FontSizeBase}"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="WorkDirTextBox"
                     Height="32"
                     TextWrapping="NoWrap"
                     Style="{StaticResource DefaultTextBoxStyle}"
                     Foreground="{DynamicResource TextPrimary}"
                     Background="{DynamicResource BgInput}"
                     Margin="0,0,0,8"/>
            <TextBlock Text="{DynamicResource AIMode_DescriptionLabel}"
                       FontSize="{StaticResource FontSizeBase}"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="DescriptionTextBox"
                     Height="32"
                     TextWrapping="NoWrap"
                     Style="{StaticResource DefaultTextBoxStyle}"
                     Foreground="{DynamicResource TextPrimary}"
                     Background="{DynamicResource BgInput}"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="StartButton" Content="{DynamicResource AIMode_Start}" Width="100" Height="36" Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButtonStyle}" Click="StartButton_Click"/>
            <Button x:Name="CancelButton" Content="{DynamicResource Common_Cancel}" Width="100" Height="36"
                    Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
