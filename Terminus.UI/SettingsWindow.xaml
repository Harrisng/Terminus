<Window x:Class="Terminus.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminus - 設置"
        Width="600" Height="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource BgPrimary}">

    <Border Background="{DynamicResource BgPrimary}" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource BgSecondary}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Terminus"
                           FontSize="{StaticResource FontSizeBase}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
                <Button Grid.Column="2"
                        Content="&#x2715;"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="28">
                <StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="設定" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="自訂你的睡眠週期參數" Style="{StaticResource PageSubtitleStyle}"/>
                    </StackPanel>

                    <!-- Calendar URL Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="日曆設置" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="日曆 URL (webcal:// 或 https://)"
                                       Style="{StaticResource CardLabelStyle}"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="CalendarUrlTextBox"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                            <TextBlock Text="從你的日曆獲取 webcal:// 或 https:// 地址"
                                       FontSize="{StaticResource FontSizeXS}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Margin="4,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Time Buffer Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="時間緩衝設置" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="總計默認：9 小時 15 分鐘"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="睡眠時間："
                                           FontSize="{StaticResource FontSizeBase}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" Margin="0,8"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                                    <TextBox x:Name="SleepTimeTextBox"
                                             Width="80" Height="32"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Style="{StaticResource DefaultTextBoxStyle}"/>
                                    <TextBlock Text=" 分鐘 (360 = 6小時)"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{StaticResource FontSizeSM}"
                                               Margin="10,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="睡前準備："
                                           FontSize="{StaticResource FontSizeBase}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" Margin="0,8"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                                    <TextBox x:Name="PreSleepTextBox"
                                             Width="80" Height="32"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Style="{StaticResource DefaultTextBoxStyle}"/>
                                    <TextBlock Text=" 分鐘"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{StaticResource FontSizeSM}"
                                               Margin="10,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="梳洗時間："
                                           FontSize="{StaticResource FontSizeBase}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" Margin="0,8"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                                    <TextBox x:Name="WashTextBox"
                                             Width="80" Height="32"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Style="{StaticResource DefaultTextBoxStyle}"/>
                                    <TextBlock Text=" 分鐘"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{StaticResource FontSizeSM}"
                                               Margin="10,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="早餐時間："
                                           FontSize="{StaticResource FontSizeBase}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" Margin="0,8"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                                    <TextBox x:Name="BreakfastTextBox"
                                             Width="80" Height="32"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Style="{StaticResource DefaultTextBoxStyle}"/>
                                    <TextBlock Text=" 分鐘"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{StaticResource FontSizeSM}"
                                               Margin="10,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="通勤時間："
                                           FontSize="{StaticResource FontSizeBase}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" Margin="0,8"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                                    <TextBox x:Name="CommuteTextBox"
                                             Width="80" Height="32"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Style="{StaticResource DefaultTextBoxStyle}"/>
                                    <TextBlock Text=" 分鐘 (105 = 1小時45分)"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{StaticResource FontSizeSM}"
                                               Margin="10,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Startup Settings Card -->
                    <Border Style="{StaticResource CardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="啟動設置" Style="{StaticResource CardTitleStyle}"/>
                            <CheckBox x:Name="StartWithWindowsCheckBox"
                                      Content="隨 Windows 啟動"
                                      IsChecked="True"
                                      Style="{StaticResource DefaultCheckBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="SaveButton" Content="儲存"
                                Width="120" Height="42"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0" Click="SaveButton_Click"/>
                        <Button x:Name="CancelButton" Content="取消"
                                Width="120" Height="42"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelButton_Click"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
