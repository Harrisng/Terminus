<Window x:Class="Terminus.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsWindow_Title}"
        Width="600" Height="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="Transparent">

    <Border Background="{DynamicResource WindowAmbientGradient}"
            BorderBrush="{DynamicResource GlassStroke}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusWindow}">
        <Grid x:Name="RootClipHost" SizeChanged="RootClipHost_SizeChanged">
            <Grid IsHitTestVisible="False">
                <Ellipse Width="520" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-210,-200,0,0" Fill="{DynamicResource AmbientIndigo}"/>
                <Ellipse Width="480" Height="400" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-200,-190" Fill="{DynamicResource AmbientCyan}"/>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BgHeader}"
                        BorderBrush="{DynamicResource BorderSecondary}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Style="{StaticResource TrafficCloseStyle}"
                                    Click="CloseButton_Click" ToolTip="{DynamicResource Common_Close}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource SettingsWindow_Title}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0">
                    <StackPanel Margin="24,20,24,26">

                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Settings_Title}" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsWindow_FirstRunHint}" Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>

                        <!-- Calendar URL -->
                        <TextBlock Text="{DynamicResource Settings_CalendarCardTitle}" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Style="{StaticResource GlassGroupStyle}" Margin="0,0,0,4">
                            <Border Style="{StaticResource SettingRowStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_CalendarUrlLabel}" Style="{StaticResource RowLabelStyle}"/>
                                    <TextBox x:Name="CalendarUrlTextBox"
                                             Height="36"
                                             Margin="0,9,0,0"
                                             Style="{StaticResource DefaultTextBoxStyle}"/>
                                    <TextBlock Text="{DynamicResource Settings_CalendarUrlHint}" Style="{StaticResource RowHintStyle}"/>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Sleep Buffers -->
                        <TextBlock Text="{DynamicResource Settings_SleepCardTitle}" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Style="{StaticResource GlassGroupStyle}" Margin="0,0,0,4">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_SleepTimeLabel}" Style="{StaticResource RowLabelStyle}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="SleepTimeTextBox" Width="72" Height="34"
                                                     HorizontalContentAlignment="Center"
                                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                                            <TextBlock Text="{DynamicResource Common_Minutes}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       FontSize="11" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRowDividerStyle}"/>

                                <Border Style="{StaticResource SettingRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_PreSleepLabel}" Style="{StaticResource RowLabelStyle}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="PreSleepTextBox" Width="72" Height="34"
                                                     HorizontalContentAlignment="Center"
                                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                                            <TextBlock Text="{DynamicResource Common_Minutes}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       FontSize="11" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRowDividerStyle}"/>

                                <Border Style="{StaticResource SettingRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_WashTimeLabel}" Style="{StaticResource RowLabelStyle}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="WashTextBox" Width="72" Height="34"
                                                     HorizontalContentAlignment="Center"
                                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                                            <TextBlock Text="{DynamicResource Common_Minutes}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       FontSize="11" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRowDividerStyle}"/>

                                <Border Style="{StaticResource SettingRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_BreakfastTimeLabel}" Style="{StaticResource RowLabelStyle}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="BreakfastTextBox" Width="72" Height="34"
                                                     HorizontalContentAlignment="Center"
                                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                                            <TextBlock Text="{DynamicResource Common_Minutes}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       FontSize="11" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRowDividerStyle}"/>

                                <Border Style="{StaticResource SettingRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_CommuteTimeLabel}" Style="{StaticResource RowLabelStyle}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="CommuteTextBox" Width="72" Height="34"
                                                     HorizontalContentAlignment="Center"
                                                     Style="{StaticResource DefaultTextBoxStyle}"/>
                                            <TextBlock Text="{DynamicResource Common_Minutes}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       FontSize="11" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Startup -->
                        <TextBlock Text="{DynamicResource Settings_StartupCardTitle}" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Style="{StaticResource GlassGroupStyle}" Margin="0,0,0,4">
                            <Border Style="{StaticResource SettingRowStyle}">
                                <CheckBox x:Name="StartWithWindowsCheckBox"
                                          Content="{DynamicResource Settings_StartWithWindows}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Left"
                                          Style="{StaticResource DefaultCheckBoxStyle}"/>
                            </Border>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button x:Name="CancelButton" Content="{DynamicResource Common_Cancel}"
                                    MinWidth="104" Height="42"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,10,0" Click="CancelButton_Click"/>
                            <Button x:Name="SaveButton" Content="{DynamicResource Common_Save}"
                                    MinWidth="104" Height="42"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SaveButton_Click"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
