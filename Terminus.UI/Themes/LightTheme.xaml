<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Background Colors - Termius style light theme -->
    <SolidColorBrush x:Key="BgPrimary" Color="#f5f6fa"/>
    <SolidColorBrush x:Key="BgSecondary" Color="#ffffff"/>
    <SolidColorBrush x:Key="BgTertiary" Color="#e8eaf0"/>
    <SolidColorBrush x:Key="BgCard" Color="#ffffff"/>
    <SolidColorBrush x:Key="BgSidebar" Color="#f0f2f5"/>
    <SolidColorBrush x:Key="BgHeader" Color="#ffffff"/>
    <SolidColorBrush x:Key="BgInput" Color="#ffffff"/>
    <SolidColorBrush x:Key="BgHover" Color="#e8eaf0"/>

    <!-- Accent Colors - Purple/Indigo -->
    <SolidColorBrush x:Key="AccentPrimary" Color="#6c5ce7"/>
    <SolidColorBrush x:Key="AccentSecondary" Color="#7c6df2"/>
    <SolidColorBrush x:Key="AccentGlow" Color="#8b7cf5"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#eae8ff"/>
    <SolidColorBrush x:Key="AccentActive" Color="#5b4dd6"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimary" Color="#1a1d2e"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#4a5168"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#7b8196"/>
    <SolidColorBrush x:Key="TextMuted" Color="#a0a5b8"/>
    <SolidColorBrush x:Key="TextAccent" Color="#6c5ce7"/>
    <SolidColorBrush x:Key="TextWhite" Color="#ffffff"/>

    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderPrimary" Color="#dfe1e8"/>
    <SolidColorBrush x:Key="BorderSecondary" Color="#e8eaf0"/>
    <SolidColorBrush x:Key="BorderAccent" Color="#6c5ce7"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="StatusSuccess" Color="#059669"/>
    <SolidColorBrush x:Key="StatusWarning" Color="#d97706"/>
    <SolidColorBrush x:Key="StatusError" Color="#dc2626"/>
    <SolidColorBrush x:Key="StatusInfo" Color="#2563eb"/>
    <SolidColorBrush x:Key="StatusIdle" Color="#6c5ce7"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#f0f2f5" Offset="0"/>
        <GradientStop Color="#f5f6fa" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6c5ce7" Offset="0"/>
        <GradientStop Color="#7c6df2" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ffffff" Offset="0"/>
        <GradientStop Color="#f5f6fa" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#ffffff" Offset="0"/>
        <GradientStop Color="#f5f6fa" Offset="1"/>
    </LinearGradientBrush>

    <!-- Glow Effects -->
    <DropShadowEffect x:Key="AccentGlowEffect" Color="#6c5ce7" Opacity="0.15" BlurRadius="16" ShadowDepth="0"/>
    <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.08" BlurRadius="12" ShadowDepth="2"/>
    <DropShadowEffect x:Key="SoftShadow" Color="#000000" Opacity="0.06" BlurRadius="8" ShadowDepth="1"/>

    <!-- Font Sizes -->
    <sys:Double x:Key="FontSizeXS">11</sys:Double>
    <sys:Double x:Key="FontSizeSM">12</sys:Double>
    <sys:Double x:Key="FontSizeBase">14</sys:Double>
    <sys:Double x:Key="FontSizeLG">16</sys:Double>
    <sys:Double x:Key="FontSizeXL">18</sys:Double>
    <sys:Double x:Key="FontSize2XL">22</sys:Double>
    <sys:Double x:Key="FontSize3XL">28</sys:Double>
    <sys:Double x:Key="FontSize4XL">36</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">48</sys:Double>

    <!-- Spacing -->
    <Thickness x:Key="SpacingXSThickness">4</Thickness>
    <Thickness x:Key="SpacingSMThickness">8</Thickness>
    <Thickness x:Key="SpacingMDThickness">16</Thickness>
    <Thickness x:Key="SpacingLGThickness">24</Thickness>
    <Thickness x:Key="SpacingXLThickness">32</Thickness>
    <Thickness x:Key="Spacing2XLThickness">48</Thickness>

    <!-- Common Margins -->
    <Thickness x:Key="MarginBottomXS">0,0,0,4</Thickness>
    <Thickness x:Key="MarginBottomSM">0,0,0,8</Thickness>
    <Thickness x:Key="MarginBottomMD">0,0,0,16</Thickness>
    <Thickness x:Key="MarginBottomLG">0,0,0,24</Thickness>
    <Thickness x:Key="MarginBottomXL">0,0,0,32</Thickness>
    <Thickness x:Key="MarginRightMD">0,0,16,0</Thickness>
    <Thickness x:Key="MarginRightBottomMD">0,0,16,16</Thickness>
    <Thickness x:Key="MarginRightBottomSM">0,0,12,8</Thickness>
    <Thickness x:Key="MarginTopBottomMD">0,16,0,16</Thickness>
    <Thickness x:Key="MarginTopLGBottomMD">0,24,0,16</Thickness>

    <!-- Corner Radius -->
    <CornerRadius x:Key="CornerRadiusSM">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMD">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLG">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXL">16</CornerRadius>

</ResourceDictionary>
